CREATE DEFINER=CURRENT_USER PROCEDURE `order_total`(IN p_id INT, OUT p_total DECIMAL(10,2))
BEGIN
  -- a comment; inside the body
  SELECT total INTO p_total FROM orders WHERE id = p_id;
END
