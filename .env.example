# OpsKat 本地验证环境（真机 real-target 验证）
#
# 复制为 .env 后填入你自己的真实目标；.env 已在 .gitignore 中，不会提交。
# 应用本身不读取本文件；只有 e2e harness 在跑测时把它加载进 process.env
# （e2e/playwright.config.ts，文件缺省则跳过），供「真机」端到端验证使用：
# 需要真实服务器时，把 host/port/user/... 接进某条验证路径（seed 资产 /
# opsctl / GUI 表单），用完清理。
# 用途、接线方式与安全须知见 docs/e2e-harness-guide.md §6
# 「Verifying against a real server」。
#
# 提醒：真实目标 = 真实副作用（非 hermetic），只跑只读 / 非破坏性操作。
# 每行一个 KEY=value、不写行内注释，直接复制成 .env 即可被简单解析。
# 只填你手上真有的服务，用不到的整段删掉即可。

# --- VNC ---
E2E_VNC_HOST=10.0.0.1
E2E_VNC_PORT=5900
# VNC 通常只需要密码；服务端要求用户名时再填写
E2E_VNC_USER=
E2E_VNC_PASSWORD=changeme
# 留空表示自动协商；需要强制经典密码认证时可填 vncauth
E2E_VNC_SECURITY_TYPE=

# --- SSH ---
E2E_SSH_HOST=10.0.0.1
E2E_SSH_PORT=22
E2E_SSH_USER=root
# 认证方式: key | password
E2E_SSH_AUTH=key
# 私钥文件路径。接入资产 config 的 private_keys 时要用绝对路径
# （connect 走 os.ReadFile，不展开 ~）—— 请自行把 ~ 展开成 $HOME。
E2E_SSH_KEY=~/.ssh/id_rsa
# 仅 E2E_SSH_AUTH=password 时填写:
# E2E_SSH_PASSWORD=

# --- MySQL (database / mysql) ---
E2E_MYSQL_HOST=10.0.0.1
E2E_MYSQL_PORT=3306
E2E_MYSQL_USER=root
E2E_MYSQL_PASSWORD=changeme
# 默认库，可留空
E2E_MYSQL_DATABASE=

# --- PostgreSQL (database / postgresql) ---
E2E_POSTGRES_HOST=10.0.0.1
E2E_POSTGRES_PORT=5432
E2E_POSTGRES_USER=postgres
E2E_POSTGRES_PASSWORD=changeme
E2E_POSTGRES_DATABASE=postgres

# --- Redis ---
E2E_REDIS_HOST=10.0.0.1
E2E_REDIS_PORT=6379
# 无密码则留空
E2E_REDIS_PASSWORD=changeme

# --- MongoDB ---
E2E_MONGO_HOST=10.0.0.1
E2E_MONGO_PORT=27017
E2E_MONGO_USER=root
E2E_MONGO_PASSWORD=changeme
E2E_MONGO_AUTHDB=admin

# --- etcd ---
E2E_ETCD_HOST=10.0.0.1
E2E_ETCD_PORT=2379
# 有认证时填写，无认证（ALLOW_NONE_AUTHENTICATION）留空
# E2E_ETCD_USER=
# E2E_ETCD_PASSWORD=

# --- OSS / 对象存储 ---
# provider 仅用于选择便捷预设；任意 S3 兼容服务都可通过 endpoint 测试（例：s3 | aliyun-oss | minio | s3-compat）
E2E_OSS_PROVIDER=minio
# endpoint: host[:port] 或 scheme://host[:port]（MinIO 的 S3 API 通常是 :9000）
E2E_OSS_ENDPOINT=10.0.0.1:9000
E2E_OSS_REGION=us-east-1
E2E_OSS_ACCESS_KEY_ID=changeme
E2E_OSS_SECRET_ACCESS_KEY=changeme
# MinIO / 自建 S3 通常需要 path-style；http 端点用 USE_SSL=false
E2E_OSS_USE_PATH_STYLE=true
E2E_OSS_USE_SSL=false

# --- RDP / 远程桌面 ---
E2E_RDP_HOST=10.0.0.1
E2E_RDP_PORT=3389
E2E_RDP_USER=Administrator
E2E_RDP_PASSWORD=changeme
# 域账号才填；工作组 / 本地账号留空
E2E_RDP_DOMAIN=
